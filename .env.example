# ==============================================================================
# TechPanda CRM - Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and fill in your credentials. Restart the server after editing.
# NEVER commit your production .env file to version control.

# ------------------------------------------------------------------------------
# 1. CORE DJANGO & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.ngrok-free.app,.ngrok.app,crm.techpanda.academy
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.app,https://crm.techpanda.academy

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Default: SQLite; Production: MySQL)
# ------------------------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ------------------------------------------------------------------------------
# 3. MULTI-DEVELOPER META INTEGRATION ARCHITECTURE (8+ DEVELOPER ACCOUNTS)
# ------------------------------------------------------------------------------
# The CRM supports 8 or more Meta developer accounts, multiple WhatsApp Business numbers,
# and multiple Facebook Pages simultaneously.
#
# Webhook endpoints accept requests from any developer account:
# - WhatsApp Webhook: /webhook/whatsapp/
# - Facebook Leads Webhook: /facebook-leads/webhook/ and /api/webhooks/meta/leads/
#
# Automated DB Provisioning:
# To automatically register or update all accounts in the database from this file, run:
#   python manage.py sync_env_meta_accounts
# ------------------------------------------------------------------------------

# Option A: Comma-Separated Multi-Secret Validation Pools
# Use these lists to allow webhook HMAC signature and handshake verification
# across multiple developer apps using a single comma-separated list.
WHATSAPP_APP_SECRETS=sec_dev_acc_1,sec_dev_acc_2,sec_dev_acc_3,sec_dev_acc_4,sec_dev_acc_5,sec_dev_acc_6,sec_dev_acc_7,sec_dev_acc_8
WHATSAPP_VERIFY_TOKENS=verify_tok_1,verify_tok_2,verify_tok_3,verify_tok_4,verify_tok_5,verify_tok_6,verify_tok_7,verify_tok_8

FB_APP_SECRETS=fb_sec_dev_1,fb_sec_dev_2,fb_sec_dev_3,fb_sec_dev_4,fb_sec_dev_5,fb_sec_dev_6,fb_sec_dev_7,fb_sec_dev_8
FB_VERIFY_TOKENS=fb_verify_1,fb_verify_2,fb_verify_3,fb_verify_4,fb_verify_5,fb_verify_6,fb_verify_7,fb_verify_8

# Option B: Numbered Multi-Account Configuration (Recommended for 8+ Developer Accounts)
# Configure each WhatsApp Business Line and developer account with individual credentials and CRM branch mapping.

# Developer Account 1 - T. Nagar Branch
WHATSAPP_1_NAME=T. Nagar Admissions Line
WHATSAPP_1_PHONE=+91 98401 11111
WHATSAPP_1_PHONE_ID=100000000000001
WHATSAPP_1_WABA_ID=200000000000001
WHATSAPP_1_ACCESS_TOKEN=EAAxxxxxx_token_dev_1
WHATSAPP_1_APP_SECRET=app_secret_dev_1
WHATSAPP_1_VERIFY_TOKEN=verify_token_dev_1
WHATSAPP_1_BRANCH=T. Nagar
WHATSAPP_1_AUTOMATION_ENABLED=true
WHATSAPP_1_IS_DEFAULT=true

