# ------------------------------------------------------------------------------
# 5. OPTIONAL: JSON SPECIFICATION FOR MASS ACCOUNT ENROLLMENT
# ------------------------------------------------------------------------------
# You can alternatively specify full JSON arrays of accounts:
# WHATSAPP_ACCOUNTS_JSON=[{"name":"Line 1","phone_id":"101","token":"EA...","app_secret":"sec1","verify_token":"tok1","branch":"T. Nagar"}]
# FB_PAGES_JSON=[{"account_name":"Dev 1","page_name":"P1","page_id":"201","page_access_token":"EA...","app_id":"301","app_secret":"sec1","verify_token":"tok1","branch":"T. Nagar"}]

# ------------------------------------------------------------------------------
# 6. GMAIL SMTP CONFIGURATION
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=idpsachin@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=idpsachin@gmail.com
EMAIL_TIMEOUT=20

# ------------------------------------------------------------------------------
# 7. TELECRM INTEGRATION & LIVE SYNC
# ------------------------------------------------------------------------------
